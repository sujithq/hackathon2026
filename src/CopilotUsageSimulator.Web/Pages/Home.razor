    private static IReadOnlyList<SpendingBudget> PatchSpendingBudget(
        IReadOnlyList<SpendingBudget> budgets,
        string? selectedId,
        bool enabled,
        string defaultId,
        SpendingBudgetScope scope,
        string? scopeId,
        decimal limit,
        decimal consumed,
        GuardrailEnforcement enforcement) =>
        PatchById(
            budgets,
            selectedId,
            enabled,
            defaultId,
            budget => budget.Id,
            budget => budget with
            {
                Scope = scope,
                ScopeId = scopeId,
                LimitUsd = limit,
                ConsumedUsd = consumed,
                Enforcement = enforcement
            },
            id => new SpendingBudget
            {
                Id = id,
                Scope = scope,
                ScopeId = scopeId,
                LimitUsd = limit,
                ConsumedUsd = consumed,
                Enforcement = enforcement
            });

    private static IReadOnlyList<T> PatchById<T>(
        IReadOnlyList<T> values,
        string? selectedId,
        bool enabled,
        string defaultId,
        Func<T, string> idSelector,
        Func<T, T> update,
        Func<string, T> create)
    {
        var patched = values.ToList();
        var index = string.IsNullOrWhiteSpace(selectedId)
            ? -1
            : patched.FindIndex(value =>
                string.Equals(idSelector(value), selectedId, StringComparison.OrdinalIgnoreCase));

        if (index >= 0)
        {
            if (enabled)
            {
                patched[index] = update(patched[index]);
            }
            else
            {
                patched.RemoveAt(index);
            }
        }
        else if (enabled)
        {
            patched.Add(create(defaultId));
        }

        return patched;
    }

    private static IReadOnlyList<T> PatchFirst<T>(
        IReadOnlyList<T> values,
        bool enabled,
        Func<T, T> update,
        Func<T> create)
    {
        var patched = values.ToList();
        if (patched.Count > 0)
        {
            if (enabled)
            {
                patched[0] = update(patched[0]);
            }
            else
            {
                patched.RemoveAt(0);
            }
        }
        else if (enabled)
        {
            patched.Add(create());
        }

        return patched;
    }

    private static IReadOnlyList<T> PatchAt<T>(
        IReadOnlyList<T> values,
        int? selectedIndex,
        bool enabled,
        Func<T, T> update,
        Func<T> create)
    {
        var patched = values.ToList();
        if (selectedIndex is >= 0 && selectedIndex < patched.Count)
        {
            if (enabled)
            {
                patched[selectedIndex.Value] = update(patched[selectedIndex.Value]);
            }
            else
            {
                patched.RemoveAt(selectedIndex.Value);
            }
        }
        else if (enabled)
        {
            patched.Add(create());
        }

        return patched;
    }

    private static IReadOnlyList<EffectiveSeatAssignment> PatchEffectiveSeat(
        IReadOnlyList<EffectiveSeatAssignment> seats,
        string? userId,
        DateTimeOffset timestamp,
        string? costCenterId)
    {
        var patched = seats.ToList();
        var index = patched.FindIndex(seat =>
            string.Equals(seat.UserId, userId, StringComparison.OrdinalIgnoreCase) &&
            timestamp >= seat.EffectiveFrom &&
            (seat.EffectiveTo is null || timestamp < seat.EffectiveTo));
        if (index >= 0)
        {
            patched[index] = patched[index] with { CostCenterId = costCenterId };
        }

        return patched;
    }

    private void CapturePatchedIds(SimulationScenario scenario)
    {
        _form.LicensingOrganizationIndex = ResolvePatchedIndex(
            scenario.Attribution?.LicensingOrganizationIds.Count ?? 0,
            _form.LicensingOrganizationIndex,
            !string.IsNullOrWhiteSpace(_form.OrganizationId));
        _form.DirectAssignmentIndex = ResolvePatchedIndex(
            scenario.Attribution?.DirectAssignments.Count ?? 0,
            _form.DirectAssignmentIndex,
            !string.IsNullOrWhiteSpace(_form.CostCenterId));

        var economic = scenario.EconomicGuardrails;
        if (economic is not null)
        {
            _form.UniversalUlbId = ResolvePatchedId(
                economic.UserLevelBudgets,
                _form.UniversalUlbId,
                _form.UseUniversalUlb,
                "ulb-universal",
                budget => budget.Id);
            _form.CostCenterUlbId = ResolvePatchedId(
                economic.UserLevelBudgets,
                _form.CostCenterUlbId,
                _form.UseCostCenterUlb,
                "ulb-cost-center",
                budget => budget.Id);
            _form.IndividualUlbId = ResolvePatchedId(
                economic.UserLevelBudgets,
                _form.IndividualUlbId,
                _form.UseIndividualUlb,
                "ulb-individual",
                budget => budget.Id);
            _form.IncludedControlId = ResolvePatchedId(
                economic.IncludedUsageControls,
                _form.IncludedControlId,
                _form.UseIncludedControl,
                "included-cost-center",
                control => control.Id);
            _form.CostCenterBudgetId = ResolvePatchedId(
                economic.SpendingBudgets,
                _form.CostCenterBudgetId,
                _form.UseCostCenterBudget,
                "budget-cost-center",
                budget => budget.Id);
            _form.OrganizationBudgetId = ResolvePatchedId(
                economic.SpendingBudgets,
                _form.OrganizationBudgetId,
                _form.UseOrganizationBudget,
                "budget-organization",
                budget => budget.Id);
            _form.EnterpriseBudgetId = ResolvePatchedId(
                economic.SpendingBudgets,
                _form.EnterpriseBudgetId,
                _form.UseEnterpriseBudget,
                "budget-enterprise",
                budget => budget.Id);
        }

        if (scenario.ActionsGuardrails is not null)
        {
            _form.ActionsBudgetId = ResolvePatchedId(
                scenario.ActionsGuardrails.Budgets,
                _form.ActionsBudgetId,
                _form.UseActionsBudget,
                "actions-budget",
                budget => budget.Id);
        }
    }

    private static string? ResolvePatchedId<T>(
        IReadOnlyList<T> values,
        string? selectedId,
        bool enabled,
        string defaultId,
        Func<T, string> idSelector)
    {
        if (!enabled)
        {
            return null;
        }

        return values
            .Select(idSelector)
            .FirstOrDefault(id => string.Equals(id, selectedId, StringComparison.OrdinalIgnoreCase))
            ?? values
                .Select(idSelector)
                .FirstOrDefault(id => string.Equals(id, defaultId, StringComparison.OrdinalIgnoreCase));
    }

    private static int? ResolvePatchedIndex(int count, int? selectedIndex, bool enabled)
    {
        if (!enabled || count == 0)
        {
            return null;
        }

        return selectedIndex is >= 0 && selectedIndex < count
            ? selectedIndex
            : count - 1;
    }

    private RuntimeGuardrailSnapshot? UpdateRuntimeGuardrails(RuntimeGuardrailSnapshot? snapshot)
    {
        if (!_form.UseRuntimeGuardrails)
        {
            return null;
        }

        return (snapshot ?? new RuntimeGuardrailSnapshot()) with
        {
            MaximumModelCalls = _form.MaximumModelCalls,
            ModelCallsConsumed = _form.ModelCallsConsumed,
            MaximumSubagentDepth = _form.MaximumSubagentDepth,
            RequestedSubagentDepth = _form.RequestedSubagentDepth,
            MaximumDuration = _form.MaximumDurationMinutes is null
                ? null
                : TimeSpan.FromMinutes((double)_form.MaximumDurationMinutes.Value),
            ElapsedDuration = TimeSpan.FromMinutes((double)_form.ElapsedDurationMinutes),
            RequestedDuration = TimeSpan.FromMinutes((double)_form.RequestedDurationMinutes),
            CliSoftCreditLimit = _form.CliSoftCreditLimit,
            CliCreditsConsumed = _form.CliCreditsConsumed
        };
    }

    private void ApplyAndRun()
    {
        ApplyOverrides();
        if (_error is null)
        {
            RunJsonCore(advanceWorkingState: true);
        }
    }

    private void RunJson() => RunJsonCore(advanceWorkingState: true);

    private void RunJsonCore(bool advanceWorkingState)
    {
        try
        {
            RunScenario(ScenarioJson.Deserialize(_scenarioJson), advanceWorkingState);
        }
        catch (Exception exception) when (exception is JsonException or SimulationException or InvalidOperationException)
        {
            _results.Clear();
            _error = exception is SimulationException simulation
                ? $"{simulation.Code}: {simulation.Message}"
                : exception.Message;
            _notice = null;
        }
    }

    private void RunScenario(
        SimulationScenario scenario,
        bool advanceWorkingState)
    {
        var session = SessionRunner.Run(ActiveEngine, scenario, _form.RepeatCount);
        _results.SetRuns(session.Runs);
        if (advanceWorkingState)
        {
            _scenarioJson = ScenarioJson.Serialize(session.NextScenario);
            LoadForm(session.NextScenario);
            _notice = _results.CompletedRuns == 0
                ? "No balances changed because the first run was not allowed."
                : $"Working balances advanced by {_results.CompletedRuns} successful run(s).";
        }
        _error = null;
    }

    private void ReloadGuidedFields()
    {
        try
        {
            LoadForm(ScenarioJson.Deserialize(_scenarioJson));
            _error = null;
            _notice = "Guided fields refreshed from JSON.";
        }
        catch (JsonException exception)
        {
            _error = exception.Message;
        }
    }

    private void LoadForm(SimulationScenario scenario)
    {
        _form = EditorMapper.MapFromScenario(scenario, ActiveConfiguration);
    }

    private async Task SaveAsync()
    {
        try
        {
            await BrowserPersistence.SaveAsync(_scenarioJson, _catalogJson, _results.GetPreferences());
            _notice = "Scenario saved in this browser.";
            _error = null;
        }
        catch (BrowserPersistenceException exception)
        {
            _error = $"{exception.Message} {exception.InnerException?.Message}";
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var saved = await BrowserPersistence.LoadAsync();
            if (saved is null)
            {
                _error = "No saved scenario was found in this browser.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(saved.CatalogJson))
            {
                _catalogJson = saved.CatalogJson;
                ApplyCatalog();
            }

            if (saved.Preferences is not null)
            {
                _results.ApplyPreferences(saved.Preferences);
            }

            _scenarioJson = saved.ScenarioJson;
            ReloadGuidedFields();
            RunJsonCore(advanceWorkingState: false);
            _notice = "Saved scenario loaded.";
        }
        catch (BrowserPersistenceException exception)
        {
            _error = $"{exception.Message} {exception.InnerException?.Message}";
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            await BrowserPersistence.ExportAsync(_scenarioJson);
        }
        catch (BrowserPersistenceException exception)
        {
            _error = $"{exception.Message} {exception.InnerException?.Message}";
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            _scenarioJson = await BrowserScenarioPersistence.ReadImportAsync(args.File);
            ReloadGuidedFields();
            RunJsonCore(advanceWorkingState: false);
            _notice = $"Imported {args.File.Name}.";
        }
        catch (Exception exception) when (exception is IOException or JsonException)
        {
            _error = exception.Message;
        }
    }

    private void ApplyCatalog()
    {
        try
        {
            _activeConfiguration = ScenarioJson.DeserializeConfiguration(_catalogJson);
            _activeEngine = new CopilotUsageSimulationEngine(_activeConfiguration);
            LoadTemplate(InitialExampleOperationId);
            _error = null;
            _notice = $"Catalog '{_activeConfiguration.Version}' applied.";
        }
        catch (Exception exception) when (exception is JsonException or ConfigurationException)
        {
            _error = exception.Message;
            _notice = null;
        }
    }

    private void ResetCatalog()
    {
        _activeConfiguration = DefaultConfiguration;
        _activeEngine = DefaultEngine;
        _catalogJson = ScenarioJson.SerializeConfiguration(DefaultConfiguration);
        _error = null;
    }

    private bool IsBlockingCategory(string category) =>
        string.Equals(_results.BlockingGuardrail?.Category, category, StringComparison.OrdinalIgnoreCase);
    private bool IsBlockingGate(string gateId) =>
        string.Equals(_results.Result?.FirstFailingGate, gateId, StringComparison.OrdinalIgnoreCase);
    private string UlbImpactClass(UserLevelBudgetKind kind) =>
        IsBlockingCategory(GuardrailCategories.UserLevelBudget) && _results.Result?.EffectiveUlb?.Kind == kind
            ? "impacted-setting"
            : "";
    private string ImpactClass(string category) =>
        _results.Result?.FirstFailingGate is null
            ? ""
            : category == GuardrailMetadataCatalog.ScenarioJsonAnchor
                ? BlockingSettingsAnchor(_results.BlockingGuardrail) == GuardrailMetadataCatalog.ScenarioJsonAnchor ? "impacted-setting" : ""
                : IsBlockingCategory(category) ? "impacted-setting" : "";
    private bool IsBlockingAdvancedSetting =>
        _results.Result?.FirstFailingGate is not null &&
        BlockingSettingsAnchor(_results.BlockingGuardrail) == GuardrailMetadataCatalog.ScenarioJsonAnchor;
    private string BlockingSettingsAnchor(AppliedGuardrail? guardrail) =>
        ResolveMetadata(guardrail).SettingsAnchor;
    private static GuardrailMetadata Metadata(string key) =>
        GuardrailMetadataCatalog.Resolve(key);
    private GuardrailMetadata ResolveMetadata(AppliedGuardrail? guardrail) =>
        GuardrailMetadataCatalog.Resolve(
            guardrail?.MetadataKey,
            guardrail?.Id ?? _results.Result?.FirstFailingGate,
            guardrail?.Category);
    private static string Friendly(string value) =>
        string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
}
