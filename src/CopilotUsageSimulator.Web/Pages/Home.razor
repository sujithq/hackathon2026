@page "/"
@inject ICopilotUsageSimulationEngine DefaultEngine
@inject EngineConfiguration DefaultConfiguration
@inject ScenarioJson ScenarioJson
@inject IJSRuntime JS

<PageTitle>Copilot usage simulator</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Agent task preflight</p>
        <h1>Will this task run—and what will it cost?</h1>
        <p>Configure the workload and enterprise guardrails, then inspect every decision the engine makes.</p>
    </div>
    <div class="hero-actions">
        <button class="button secondary" @onclick="SaveAsync">Save locally</button>
        <button class="button secondary" @onclick="LoadAsync">Load saved</button>
        <button class="button secondary" @onclick="ExportAsync">Export JSON</button>
        <label class="button secondary file-button">
            Import JSON
            <InputFile OnChange="ImportAsync" accept=".json,application/json" />
        </label>
    </div>
</section>

<section class="template-strip">
    <span>Start from:</span>
    <button @onclick="@(() => LoadTemplate("cloud-agent"))">Cloud agent</button>
    <button @onclick="@(() => LoadTemplate("code-review"))">Code review</button>
    <button @onclick="@(() => LoadTemplate("chat"))">Chat</button>
</section>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="message error"><strong>Simulation error</strong><span>@_error</span></div>
}
@if (!string.IsNullOrWhiteSpace(_notice))
{
    <div class="message success">@_notice</div>
}

<div class="workspace">
    <section class="panel configuration-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">Scenario</p>
                <h2>Task and overrides</h2>
            </div>
            <span class="step">1</span>
        </div>

        <section class="setting-card scope-card">
            <label class="setting-toggle">
                <input type="checkbox" @bind="_form.CostChecksOnly" />
                <span>
                    <strong>Cost-related checks only <span class="default-badge">Default</span></strong>
                    <small>Show and evaluate billing attribution, ULBs, included credits, paid usage, and spending budgets. Turn off to include access, policy, runtime, and approval checks.</small>
                </span>
            </label>
        </section>

        <div class="field full">
            <label for="task">Task for the agent <span class="json-sync-badge">Scenario JSON</span></label>
            <textarea id="task" rows="4" @bind="_form.Task"></textarea>
            <small>The task is descriptive. Token and runtime values below define the estimate.</small>
        </div>

        <div class="form-grid">
            <div class="field">
                <div class="field-label">
                    <label for="operation">Operation <span class="cost-related-badge">Cost related</span></label>
                    <DocsLink Url="@GitHubDocumentationLinks.CopilotBilling" Topic="billable Copilot features" />
                </div>
                <select id="operation" @bind="_form.OperationId">
                    @foreach (var operation in ActiveConfiguration.Operations)
                    {
                        <option value="@operation.Id">@operation.Id</option>
                    }
                </select>
            </div>
            <div class="field">
                <div class="field-label">
                    <label for="plan">Plan <span class="cost-related-badge">Cost related</span></label>
                    <DocsLink Url="@GitHubDocumentationLinks.UsageBasedBilling" Topic="Copilot plan billing" />
                </div>
                <select id="plan" @bind="_form.PlanId">
                    @foreach (var plan in ActiveConfiguration.Plans)
                    {
                        <option value="@plan.Id">@plan.Id</option>
                    }
                </select>
            </div>
            @if (OperationUsesRepositoryVisibility)
            {
                <div class="field">
                    <label for="visibility">Repository <span class="cost-related-badge">Cost related</span></label>
                    <select id="visibility" @bind="_form.RepositoryVisibility">
                        @foreach (var value in Enum.GetValues<RepositoryVisibility>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </div>
            }
            @if (OperationConsumesAiCredits)
            {
                <div class="field">
                    <div class="field-label">
                        <label for="model">Model <span class="cost-related-badge">Cost related</span></label>
                        <DocsLink Url="@GitHubDocumentationLinks.ModelsAndPricing" Topic="Copilot models and pricing" />
                    </div>
                    <select id="model" @bind="_form.ModelId">
                        @foreach (var model in ActiveConfiguration.Models)
                        {
                            <option value="@model.Id">@model.Id</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="operation-context">
            <strong>@_form.OperationId</strong>
            <span>@OperationContext</span>
        </div>

        @if (OperationConsumesAiCredits)
        {
            <h3 class="synced-heading">
                Expected model call
                <span class="json-sync-badge">Scenario JSON</span>
                <span class="cost-related-badge">Cost related</span>
                <DocsLink Url="@GitHubDocumentationLinks.ModelsAndPricing" Topic="token pricing" />
            </h3>
            <div class="form-grid compact">
                <NumberField Label="Context tokens" DocsUrl="@GitHubDocumentationLinks.ModelsAndPricing" DocsTopic="context-tier pricing" @bind-Value="_form.ContextTokens" />
                <NumberField Label="Fresh input" DocsUrl="@GitHubDocumentationLinks.ModelsAndPricing" DocsTopic="input-token pricing" @bind-Value="_form.FreshInputTokens" />
                <NumberField Label="Cached input" DocsUrl="@GitHubDocumentationLinks.ModelsAndPricing" DocsTopic="cached-input pricing" @bind-Value="_form.CachedInputTokens" />
                <NumberField Label="Cache write" DocsUrl="@GitHubDocumentationLinks.ModelsAndPricing" DocsTopic="cache-write pricing" @bind-Value="_form.CacheWriteTokens" />
                <NumberField Label="Output tokens" DocsUrl="@GitHubDocumentationLinks.ModelsAndPricing" DocsTopic="output-token pricing" @bind-Value="_form.OutputTokens" />
            </div>
        }

        <h3 class="synced-heading">
            Simulation run
            <span class="json-sync-badge">Scenario JSON</span>
            <span class="cost-related-badge">Cost related</span>
        </h3>
        <div class="form-grid compact">
            @if (OperationUsesActions)
            {
                <div id="actions-minutes-settings">
                    <DecimalField Label="Actions minutes" DocsUrl="@GitHubDocumentationLinks.ActionsSpending" DocsTopic="GitHub Actions spending" @bind-Value="_form.ActionsMinutes" />
                </div>
            }
            <div class="field">
                <label>Repeat task</label>
                <input type="number" min="1" max="1000" @bind="_form.RepeatCount" />
                <small>Runs sequentially and carries balances forward.</small>
            </div>
        </div>

        @if (OperationConsumesAiCredits)
        {
            <h3 class="synced-heading">
                Billing and attribution
                <span class="json-sync-badge">Scenario JSON</span>
                <span class="cost-related-badge">Cost related</span>
                <DocsLink Url="@GitHubDocumentationLinks.CostCenters" Topic="cost centers" />
            </h3>
            <div class="form-grid compact">
                <div class="field">
                    <div class="field-label">
                        <label>Cost center</label>
                        <DocsLink Url="@GitHubDocumentationLinks.CostCenters" Topic="cost centers" />
                    </div>
                    <input @bind="_form.CostCenterId" />
                </div>
                <div class="field">
                    <div class="field-label">
                        <label>Licensing organization</label>
                        <DocsLink Url="@GitHubDocumentationLinks.CostCenterAllocation" Topic="Copilot cost attribution" />
                    </div>
                    <input @bind="_form.OrganizationId" />
                </div>
                <div id="pool-settings" class="@ImpactClass("included-pool")">
                    <DecimalField Label="Pool consumed" DocsUrl="@GitHubDocumentationLinks.UsageBasedBilling" DocsTopic="pooled AI credits" @bind-Value="_form.PoolConsumed" />
                </div>
                <div id="paid-usage-settings" class="field @ImpactClass("paid-usage-authorization")">
                    <div class="field-label">
                        <label>Paid usage</label>
                        <DocsLink Url="@GitHubDocumentationLinks.CopilotBudgets" Topic="paid Copilot usage" />
                    </div>
                    <select @bind="_form.PaidUsage">
                        @foreach (var value in Enum.GetValues<GuardrailValue>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </div>
            </div>

            <h3 class="synced-heading">
                Optional guardrails
                <span class="json-sync-badge">Scenario JSON</span>
                <span class="cost-related-badge">Cost related</span>
            </h3>
            <p class="section-help">ULB precedence: Individual exception → Cost center → Universal default. Only the most specific applicable ULB is enforced.</p>
            <div class="guardrail-editor">
            <section id="universal-ulb-settings" class="setting-card @UlbImpactClass(UserLevelBudgetKind.Universal)">
                <div class="setting-header">
                    <label class="setting-toggle">
                        <input type="checkbox" @bind="_form.UseUniversalUlb" />
                        <span>
                            <strong>Universal ULB</strong>
                            <small>Default per-user limit for every Copilot-licensed user.</small>
                        </span>
                    </label>
                    <DocsLink Url="@GitHubDocumentationLinks.CopilotBudgets" Topic="universal user-level budgets" />
                </div>
                @if (_form.UseUniversalUlb)
                {
                    <div class="form-grid">
                        <DecimalField Label="Credit limit per user" @bind-Value="_form.UniversalUlbLimit" />
                        <DecimalField Label="Current user credits used" @bind-Value="_form.UniversalUlbConsumed" />
                    </div>
                }
            </section>

            <section id="cost-center-ulb-settings" class="setting-card @UlbImpactClass(UserLevelBudgetKind.CostCenter)">
                <div class="setting-header">
                    <label class="setting-toggle">
                        <input type="checkbox" @bind="_form.UseCostCenterUlb" />
                        <span>
                            <strong>Cost-center ULB</strong>
                            <small>Per-user default for the selected cost center; overrides the universal ULB.</small>
                        </span>
                    </label>
                    <DocsLink Url="@GitHubDocumentationLinks.CopilotBudgets" Topic="cost-center user-level budgets" />
                </div>
                @if (_form.UseCostCenterUlb)
                {
                    <div class="form-grid">
                        <DecimalField Label="Credit limit per member" @bind-Value="_form.CostCenterUlbLimit" />
                        <DecimalField Label="Current user credits used" @bind-Value="_form.CostCenterUlbConsumed" />
                    </div>
                }
            </section>

            <section id="individual-ulb-settings" class="setting-card @UlbImpactClass(UserLevelBudgetKind.Individual)">
                <div class="setting-header">
                    <label class="setting-toggle">
                        <input type="checkbox" @bind="_form.UseIndividualUlb" />
                        <span>
                            <strong>Individual ULB exception</strong>
                            <small>Specific limit for the attributed user; overrides cost-center and universal ULBs.</small>
                        </span>
                    </label>
                    <DocsLink Url="@GitHubDocumentationLinks.CopilotBudgets" Topic="individual user-level budgets" />
                </div>
                @if (_form.UseIndividualUlb)
                {
                    <div class="form-grid">
                        <DecimalField Label="Credit limit" @bind-Value="_form.UlbLimit" />
                        <DecimalField Label="Credits already used" @bind-Value="_form.UlbConsumed" />
                    </div>
                }
            </section>

            <section id="included-control-settings" class="setting-card @ImpactClass("included-usage-control")">
                <div class="setting-header">
                    <label class="setting-toggle">
                        <input type="checkbox" @bind="_form.UseIncludedControl" />
                        <span>
                            <strong>Cost-center included-usage control</strong>
                            <small>Limit how the attributed cost center uses included credits.</small>
                        </span>
                    </label>
                    <DocsLink Url="@GitHubDocumentationLinks.CopilotBudgets" Topic="included usage controls" />
                </div>
                @if (_form.UseIncludedControl)
                {
                    <div class="form-grid">
                        <DecimalField Label="Credits already used" @bind-Value="_form.IncludedControlConsumed" />
                        <div class="field">
                            <label>When included credits run out</label>
                            <select @bind="_form.IncludedOverflow">
                                @foreach (var value in Enum.GetValues<IncludedOverflowBehavior>())
                                {
                                    <option value="@value">@Friendly(value.ToString())</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            </section>
            </div>
        }

        @if (!_form.CostChecksOnly && OperationConsumesAiCredits)
        {
            <h3 class="synced-heading">Runtime guardrails <span class="json-sync-badge">Scenario JSON</span></h3>
            <section id="runtime-settings" class="setting-card @ImpactClass("runtime")">
                <label class="setting-toggle">
                    <input type="checkbox" @bind="_form.UseRuntimeGuardrails" />
                    <span>
                        <strong>Agent runtime limits</strong>
                        <small>Operational limits for cumulative calls, duration, depth, and CLI credits.</small>
                    </span>
                </label>
                @if (_form.UseRuntimeGuardrails)
                {
                    <div class="form-grid">
                        <div class="field">
                            <label>Maximum model calls</label>
                            <input type="number" min="0" @bind="_form.MaximumModelCalls" />
                        </div>
                        <div class="field">
                            <label>Model calls already used</label>
                            <input type="number" min="0" @bind="_form.ModelCallsConsumed" />
                        </div>
                        <div class="field">
                            <label>Maximum duration (minutes)</label>
                            <input type="number" min="0" step="0.1" @bind="_form.MaximumDurationMinutes" />
                        </div>
                        <div class="field">
                            <label>Duration already used (minutes)</label>
                            <input type="number" min="0" step="0.1" @bind="_form.ElapsedDurationMinutes" />
                        </div>
                        <div class="field">
                            <label>Duration needed per run (minutes)</label>
                            <input type="number" min="0" step="0.1" @bind="_form.RequestedDurationMinutes" />
                        </div>
                        <div class="field">
                            <label>Maximum subagent depth</label>
                            <input type="number" min="0" @bind="_form.MaximumSubagentDepth" />
                        </div>
                        <div class="field">
                            <label>Requested subagent depth</label>
                            <input type="number" min="0" @bind="_form.RequestedSubagentDepth" />
                        </div>
                        <div class="field">
                            <label>CLI session credit limit</label>
                            <input type="number" min="0" step="0.01" @bind="_form.CliSoftCreditLimit" />
                        </div>
                        <DecimalField Label="CLI credits already used" @bind-Value="_form.CliCreditsConsumed" />
                    </div>
                }
            </section>
        }

        @if (OperationConsumesAiCredits || OperationUsesActions)
        {
            <h3 class="synced-heading">
                Spending budgets
                <span class="json-sync-badge">Scenario JSON</span>
                <span class="cost-related-badge">Cost related</span>
            </h3>
            <p class="section-help">Only budget types used by this operation are shown. Disabled budgets are not evaluated.</p>
            <div class="budget-grid">
                @if (OperationConsumesAiCredits)
                {
                    <BudgetCard Title="Cost-center budget"
                                Id="cost-center-budget-settings"
                                Highlighted="@IsBlockingGate("budget-cost-center")"
                                DocsUrl="@GitHubDocumentationLinks.MeteredBudgets"
                                Help="Applies to metered usage attributed to this cost center."
                                @bind-Enabled="_form.UseCostCenterBudget"
                                @bind-Limit="_form.CostCenterBudgetLimit"
                                @bind-Consumed="_form.CostCenterBudgetConsumed"
                                @bind-Enforcement="_form.CostCenterBudgetEnforcement" />
                    <BudgetCard Title="Organization budget"
                                Id="organization-budget-settings"
                                Highlighted="@IsBlockingGate("budget-organization")"
                                DocsUrl="@GitHubDocumentationLinks.MeteredBudgets"
                                Help="Used when organization-level metered spending is constrained."
                                @bind-Enabled="_form.UseOrganizationBudget"
                                @bind-Limit="_form.OrganizationBudgetLimit"
                                @bind-Consumed="_form.OrganizationBudgetConsumed"
                                @bind-Enforcement="_form.OrganizationBudgetEnforcement" />
                    <BudgetCard Title="Enterprise budget"
                                Id="enterprise-budget-settings"
                                Highlighted="@IsBlockingGate("budget-enterprise")"
                                DocsUrl="@GitHubDocumentationLinks.MeteredBudgets"
                                Help="Applies across the enterprise unless the cost center is excluded."
                                @bind-Enabled="_form.UseEnterpriseBudget"
                                @bind-Limit="_form.EnterpriseBudgetLimit"
                                @bind-Consumed="_form.EnterpriseBudgetConsumed"
                                @bind-Enforcement="_form.EnterpriseBudgetEnforcement" />
                }
                @if (OperationUsesActions)
                {
                    <BudgetCard Title="Actions budget"
                                Id="actions-budget-settings"
                                Highlighted="@IsBlockingCategory("actions-budget")"
                                DocsUrl="@GitHubDocumentationLinks.MeteredBudgets"
                                Help="Controls additional GitHub Actions runner charges."
                                @bind-Enabled="_form.UseActionsBudget"
                                @bind-Limit="_form.ActionsBudgetLimit"
                                @bind-Consumed="_form.ActionsBudgetConsumed"
                                @bind-Enforcement="_form.ActionsBudgetEnforcement" />
                }
            </div>
        }

        <div class="primary-actions">
            <button class="button primary" @onclick="ApplyAndRun">Apply overrides and simulate</button>
            <button class="button ghost" @onclick="ApplyOverrides">Apply without running</button>
        </div>
        <p class="simulation-note">
            Successful runs advance the working balances. Choose a template or load a saved scenario to reset the starting state.
        </p>

        <details id="scenario-json"
                 class="advanced @ImpactClass("scenario-json")"
                 open="@IsBlockingAdvancedSetting">
            <summary>
                <span>Developer options: complete scenario JSON</span>
                <small>Fields marked “Scenario JSON” synchronize with this document</small>
            </summary>
            <textarea class="json-editor" spellcheck="false" @bind="_scenarioJson"></textarea>
            <div class="primary-actions">
                <button class="button primary" @onclick="RunJson">Simulate JSON</button>
                <button class="button ghost" @onclick="ReloadGuidedFields">Load JSON into guided fields</button>
            </div>
        </details>

        <details class="advanced">
            <summary>
                <span>Developer options: pricing and policy catalog</span>
                <small>Plans, models, prices, operations, gates, multipliers, and runners</small>
            </summary>
            <textarea class="json-editor catalog-editor" spellcheck="false" @bind="_catalogJson"></textarea>
            <div class="primary-actions">
                <button class="button primary" @onclick="ApplyCatalog">Apply catalog</button>
                <button class="button ghost" @onclick="ResetCatalog">Reset default catalog</button>
            </div>
        </details>
    </section>

    <section class="panel results-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">Result</p>
                <h2>Decision and cost</h2>
            </div>
            <span class="step">2</span>
        </div>

        @if (_result is null)
        {
            <div class="empty-state">Configure a scenario and start a simulation.</div>
        }
        else
        {
            <div class="decision-banner @StatusClass(_result.Decision.ToString())">
                <div>
                    <small>Decision</small>
                    <strong>@FormatDecision(_result.Decision)</strong>
                </div>
                @if (_result.FirstFailingGate is not null)
                {
                    <div>
                        <small>First failing check</small>
                        <code>@_result.FirstFailingGate</code>
                    </div>
                }
            </div>

            @if (_result.FirstFailingGate is not null)
            {
                var blocker = BlockingGuardrail;
                <section class="blocking-explanation">
                    <div class="blocking-heading">
                        <div>
                            <small>Why it stopped</small>
                            <h3>@BlockingSourceLabel(blocker)</h3>
                        </div>
                        <code>@_result.FirstFailingGate</code>
                    </div>
                    <p>@BlockingScopeExplanation(blocker)</p>
                    @if (blocker is not null && (blocker.Limit is not null || blocker.Requested is not null))
                    {
                        <div class="blocking-values">
                            <span><small>Configured limit</small><strong>@FormatNullable(blocker.Limit) @BlockingUnit(blocker)</strong></span>
                            <span><small>Already used</small><strong>@FormatNullable(blocker.ConsumedBefore) @BlockingUnit(blocker)</strong></span>
                            <span><small>This run needs</small><strong>@FormatNullable(blocker.Requested) @BlockingUnit(blocker)</strong></span>
                            <span><small>@BlockingProjectionLabel(blocker)</small><strong>@FormatBlockingProjection(blocker) @BlockingUnit(blocker)</strong></span>
                        </div>
                    }
                    <p class="blocking-message">@(blocker?.Message ?? "The simulation stopped at this check.")</p>
                    <a class="button ghost blocking-link" href="#@BlockingSettingsAnchor(blocker)">Review highlighted setting</a>
                </section>
            }

            <div class="metrics">
                <Metric Label="Runs completed" Value="@($"{CompletedRuns} / {_form.RepeatCount}")" />
                <Metric Label="AI credits consumed" Value="@Format(TotalConsumedCredits)" />
                <Metric Label="Included credits" Value="@Format(TotalIncludedCredits)" />
                <Metric Label="Metered credits" Value="@Format(TotalMeteredCredits)" />
                <Metric Label="Metered cost" Value="@TotalMeteredUsd.ToString("C")" />
                <Metric Label="Actions cost" Value="@TotalActionsUsd.ToString("C")" />
                <Metric Label="Pool remaining" Value="@Format(_result.Remaining.IncludedPoolCredits)" />
            </div>

            @if (_runs.Count > 1 || _form.RepeatCount > 1)
            {
                <details class="run-history">
                    <summary>Run history (@_runs.Count evaluated)</summary>
                    <div class="run-table">
                        <span>#</span><span>Decision</span><span>Credits</span><span>Metered</span><span>Stopped by</span>
                        @for (var index = 0; index < _runs.Count; index++)
                        {
                            var run = _runs[index];
                            <strong>@(index + 1)</strong>
                            <span class="@StatusClass(run.Decision.ToString())">@FormatDecision(run.Decision)</span>
                            <span>@Format(run.Allocation.TotalCredits)</span>
                            <span>@run.Allocation.MeteredUsd.ToString("C")</span>
                            <code>@(run.FirstFailingGate ?? "—")</code>
                        }
                    </div>
                </details>
            }

            <div class="summary-grid">
                <div>
                    <small>Attributed user</small>
                    <strong>@(_result.Attribution?.UserId ?? "—")</strong>
                </div>
                <div>
                    <small>Cost center</small>
                    <strong>@(_result.Attribution?.CostCenterId ?? "Enterprise only")</strong>
                </div>
                <div>
                    <small>Organization</small>
                    <strong>@(_result.Attribution?.LicensingOrganizationId ?? "—")</strong>
                </div>
                <div>
                    <small>Effective ULB</small>
                    <strong>@(_result.EffectiveUlb?.Id ?? "None")</strong>
                </div>
            </div>

            <div class="trace-heading">
                <div>
                    <h3>Guardrail checks</h3>
                    <p>@VisibleGuardrails.Count() of @_result.AppliedGuardrails.Count checks shown</p>
                </div>
                <select aria-label="Check visibility" @bind="_visibilityMode">
                    <option value="all">Show all</option>
                    <option value="issues">Failures and warnings</option>
                    <option value="failures">Failures only</option>
                    <option value="custom">Custom categories</option>
                </select>
            </div>

            @if (_visibilityMode == "custom")
            {
                <div class="category-filter">
                    @foreach (var category in _result.AppliedGuardrails.Select(x => x.Category).Distinct())
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@(!_hiddenCategories.Contains(category))"
                                   @onchange="eventArgs => SetCategory(category, eventArgs)" />
                            @category
                        </label>
                    }
                </div>
            }

            <div class="check-list">
                @{
                    var checkNumber = 0;
                }
                @foreach (var guardrail in VisibleGuardrails)
                {
                    checkNumber++;
                    <article class="check">
                        <span class="check-index">@checkNumber</span>
                        <span class="status-dot @StatusClass(guardrail.Outcome.ToString())"></span>
                        <div class="check-body">
                            <div class="check-title">
                                <strong>@guardrail.Id</strong>
                                <span>@guardrail.Category</span>
                                <span class="outcome @StatusClass(guardrail.Outcome.ToString())">@guardrail.Outcome</span>
                            </div>
                            <p>@guardrail.Message</p>
                            @if (guardrail.Limit is not null || guardrail.Requested is not null)
                            {
                                <div class="check-values">
                                    <span>Limit <strong>@FormatNullable(guardrail.Limit)</strong></span>
                                    <span>Before <strong>@FormatNullable(guardrail.ConsumedBefore)</strong></span>
                                    <span>Requested <strong>@FormatNullable(guardrail.Requested)</strong></span>
                                    <span>After <strong>@FormatNullable(guardrail.RemainingAfter)</strong></span>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (_result.Explanation.Count > 0)
            {
                <details class="explanation">
                    <summary>Decision trace and assumptions</summary>
                    <ol>
                        @foreach (var entry in _result.Explanation)
                        {
                            <li><code>@entry.Code</code> @entry.Message</li>
                        }
                    </ol>
                    @foreach (var assumption in _result.Assumptions)
                    {
                        <p class="assumption">@assumption</p>
                    }
                </details>
            }
        }
    </section>
</div>

@code {
    private const string StorageKey = "copilot-usage-simulator.scenario.v1";
    private const string CatalogStorageKey = "copilot-usage-simulator.catalog.v1";
    private const string PreferenceStorageKey = "copilot-usage-simulator.preferences.v1";
    private readonly HashSet<string> _hiddenCategories = new(StringComparer.OrdinalIgnoreCase);
    private EngineConfiguration? _activeConfiguration;
    private ICopilotUsageSimulationEngine? _activeEngine;
    private GuidedForm _form = new();
    private string _scenarioJson = "";
    private string _catalogJson = "";
    private string _visibilityMode = "all";
    private string? _error;
    private string? _notice;
    private SimulationResult? _result;
    private readonly List<SimulationResult> _runs = [];

    private EngineConfiguration ActiveConfiguration => _activeConfiguration ?? DefaultConfiguration;
    private ICopilotUsageSimulationEngine ActiveEngine => _activeEngine ?? DefaultEngine;
    private OperationDefinition? SelectedOperation => ActiveConfiguration.Operations.FirstOrDefault(
        operation => string.Equals(operation.Id, _form.OperationId, StringComparison.OrdinalIgnoreCase));
    private bool OperationConsumesAiCredits => SelectedOperation?.IsBilled == true;
    private bool OperationUsesActions => SelectedOperation?.ActionsMetering != ActionsMeteringMode.None;
    private bool OperationUsesRepositoryVisibility =>
        SelectedOperation?.ActionsMetering == ActionsMeteringMode.PrivateRepositories;
    private string OperationContext => SelectedOperation switch
    {
        null => "This operation is not present in the active catalog.",
        { IsBilled: false } =>
            "This operation does not consume AI credits. Token, billing, runtime, and spending controls are hidden and not evaluated.",
        { ActionsMetering: ActionsMeteringMode.Always } =>
            "This operation consumes AI credits and always uses GitHub Actions. Repository visibility does not change runner metering.",
        { ActionsMetering: ActionsMeteringMode.PrivateRepositories } =>
            "This operation consumes AI credits. GitHub Actions charges apply to private and internal repositories, so repository visibility is required.",
        _ =>
            "This operation consumes AI credits but does not use GitHub Actions. Runner and repository controls are hidden and not evaluated."
    };
    private IEnumerable<AppliedGuardrail> VisibleGuardrails =>
        _result?.AppliedGuardrails.Where(ShouldShow) ?? [];
    private AppliedGuardrail? BlockingGuardrail =>
        _result?.AppliedGuardrails.FirstOrDefault(guardrail =>
            string.Equals(guardrail.Id, _result.FirstFailingGate, StringComparison.OrdinalIgnoreCase))
        ?? _result?.AppliedGuardrails.FirstOrDefault(guardrail =>
            guardrail.Outcome is GuardrailOutcome.Blocked
                or GuardrailOutcome.SoftStopped
                or GuardrailOutcome.Waiting
                or GuardrailOutcome.Indeterminate);
    private int CompletedRuns => _runs.Count(run => run.Decision == SimulationDecision.Allowed);
    private decimal TotalConsumedCredits => _runs
        .Where(run => run.Decision == SimulationDecision.Allowed)
        .Sum(run => run.Allocation.TotalCredits);
    private decimal TotalIncludedCredits => _runs
        .Where(run => run.Decision == SimulationDecision.Allowed)
        .Sum(run => run.Allocation.IncludedCredits);
    private decimal TotalMeteredCredits => _runs
        .Where(run => run.Decision == SimulationDecision.Allowed)
        .Sum(run => run.Allocation.MeteredCredits);
    private decimal TotalMeteredUsd => _runs
        .Where(run => run.Decision == SimulationDecision.Allowed)
        .Sum(run => run.Allocation.MeteredUsd);
    private decimal TotalActionsUsd => _runs
        .Where(run => run.Decision == SimulationDecision.Allowed)
        .Sum(run => run.ActionsUsage?.AdditionalUsd ?? 0m);

    protected override void OnInitialized()
    {
        ResetCatalog();
        LoadTemplate("cloud-agent");
    }

    private void LoadTemplate(string template)
    {
        var scenario = ExampleScenarioFactory.Create(ActiveConfiguration, template);
        _scenarioJson = ScenarioJson.Serialize(scenario);
        LoadForm(scenario);
        RunScenario(scenario, advanceWorkingState: false);
        _notice = null;
    }

    private void ApplyOverrides()
    {
        try
        {
            var scenario = ScenarioJson.Deserialize(_scenarioJson);
            var call = scenario.Calls.FirstOrDefault() ?? new ModelCallInput { ModelId = _form.ModelId };
            call = call with
            {
                ModelId = _form.ModelId,
                ContextTokens = _form.ContextTokens,
                FreshInputTokens = _form.FreshInputTokens,
                CachedInputTokens = _form.CachedInputTokens,
                CacheWriteTokens = _form.CacheWriteTokens,
                OutputTokens = _form.OutputTokens
            };

            var metadata = new Dictionary<string, string>(scenario.Metadata, StringComparer.OrdinalIgnoreCase)
            {
                ["task"] = _form.Task,
                ["repeatCount"] = _form.RepeatCount.ToString()
            };
            var attribution = scenario.Attribution is null
                ? null
                : scenario.Attribution with
                {
                    LicensingOrganizationIds = string.IsNullOrWhiteSpace(_form.OrganizationId)
                        ? []
                        : [_form.OrganizationId],
                    DirectAssignments = string.IsNullOrWhiteSpace(_form.CostCenterId)
                        ? []
                        : [new EffectiveCostCenterAssignment { CostCenterId = _form.CostCenterId }]
                };
            var billing = scenario.BillingContext is null
                ? null
                : scenario.BillingContext with
                {
                    SeatAssignments = scenario.BillingContext.SeatAssignments
                        .Select(seat => seat.UserId == scenario.Attribution?.UserId
                            ? seat with
                            {
                                CostCenterId = string.IsNullOrWhiteSpace(_form.CostCenterId)
                                    ? null
                                    : _form.CostCenterId
                            }
                            : seat)
                        .ToArray()
                };
            var economic = UpdateEconomic(scenario.EconomicGuardrails, attribution?.UserId);
            var operationDefaults = OperationUsesActions
                ? ExampleScenarioFactory.Create(ActiveConfiguration, _form.OperationId)
                : null;
            var sourceActionsUsage = scenario.ActionsUsage ?? operationDefaults?.ActionsUsage;
            var actionsUsage = sourceActionsUsage is null
                ? null
                : sourceActionsUsage with { Minutes = _form.ActionsMinutes };
            var actionsGuardrails = UpdateActionsGuardrails(
                scenario.ActionsGuardrails ?? operationDefaults?.ActionsGuardrails);
            var runtimeGuardrails = UpdateRuntimeGuardrails(scenario.RuntimeGuardrails);

            scenario = scenario with
            {
                OperationId = _form.OperationId,
                PlanId = _form.PlanId,
                CheckScope = _form.CostChecksOnly
                    ? SimulationCheckScope.CostRelatedOnly
                    : SimulationCheckScope.All,
                RepositoryVisibility = _form.RepositoryVisibility,
                Calls = [call],
                Metadata = metadata,
                Attribution = attribution,
                BillingContext = billing,
                EconomicGuardrails = economic,
                ActionsUsage = actionsUsage,
                ActionsGuardrails = actionsGuardrails,
                RuntimeGuardrails = runtimeGuardrails
            };
            _scenarioJson = ScenarioJson.Serialize(scenario);
            _error = null;
            _notice = "Guided overrides applied to the complete scenario.";
        }
        catch (Exception exception) when (exception is JsonException or SimulationException)
        {
            _error = exception.Message;
            _notice = null;
        }
    }

    private EconomicGuardrailSnapshot? UpdateEconomic(
        EconomicGuardrailSnapshot? economic,
        string? userId)
    {
        if (economic is null)
        {
            return null;
        }

        var budgets = new List<SpendingBudget>();
        AddBudget(_form.UseCostCenterBudget, "budget-cost-center", SpendingBudgetScope.CostCenter,
            _form.CostCenterId, _form.CostCenterBudgetLimit, _form.CostCenterBudgetConsumed,
            _form.CostCenterBudgetEnforcement);
        AddBudget(_form.UseOrganizationBudget, "budget-organization", SpendingBudgetScope.Organization,
            _form.OrganizationId, _form.OrganizationBudgetLimit, _form.OrganizationBudgetConsumed,
            _form.OrganizationBudgetEnforcement);
        AddBudget(_form.UseEnterpriseBudget, "budget-enterprise", SpendingBudgetScope.Enterprise,
            null, _form.EnterpriseBudgetLimit, _form.EnterpriseBudgetConsumed,
            _form.EnterpriseBudgetEnforcement);

        var ulbs = economic.UserLevelBudgets
            .Where(ulb =>
                ulb.Kind != UserLevelBudgetKind.Universal &&
                !(ulb.Kind == UserLevelBudgetKind.CostCenter &&
                  string.Equals(ulb.TargetId, _form.CostCenterId, StringComparison.OrdinalIgnoreCase)) &&
                !(ulb.Kind == UserLevelBudgetKind.Individual &&
                  string.Equals(ulb.TargetId, userId, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        if (_form.UseUniversalUlb)
        {
            ulbs.Add(new UserLevelBudget
            {
                Id = "ulb-universal",
                Kind = UserLevelBudgetKind.Universal,
                LimitCredits = _form.UniversalUlbLimit,
                ConsumedCredits = _form.UniversalUlbConsumed
            });
        }
        if (_form.UseCostCenterUlb && !string.IsNullOrWhiteSpace(_form.CostCenterId))
        {
            ulbs.Add(new UserLevelBudget
            {
                Id = "ulb-cost-center",
                Kind = UserLevelBudgetKind.CostCenter,
                TargetId = _form.CostCenterId,
                LimitCredits = _form.CostCenterUlbLimit,
                ConsumedCredits = _form.CostCenterUlbConsumed
            });
        }
        if (_form.UseIndividualUlb)
        {
            ulbs.Add(new UserLevelBudget
            {
                Id = "ulb-individual",
                Kind = UserLevelBudgetKind.Individual,
                TargetId = userId,
                LimitCredits = _form.UlbLimit,
                ConsumedCredits = _form.UlbConsumed
            });
        }

        var includedControls = _form.UseIncludedControl && !string.IsNullOrWhiteSpace(_form.CostCenterId)
            ? new CostCenterIncludedUsageControl[]
            {
                new()
                {
                    Id = "included-cost-center",
                    CostCenterId = _form.CostCenterId,
                    ConsumedCredits = _form.IncludedControlConsumed,
                    OverflowBehavior = _form.IncludedOverflow
                }
            }
            : [];
        return economic with
        {
            EnterprisePoolConsumedCredits = _form.PoolConsumed,
            PaidUsage = economic.PaidUsage with { State = _form.PaidUsage },
            SpendingBudgets = budgets,
            UserLevelBudgets = ulbs,
            IncludedUsageControls = includedControls
        };

        void AddBudget(
            bool enabled,
            string id,
            SpendingBudgetScope scope,
            string? scopeId,
            decimal limit,
            decimal consumed,
            GuardrailEnforcement enforcement)
        {
            if (enabled)
            {
                budgets.Add(new SpendingBudget
                {
                    Id = id,
                    Scope = scope,
                    ScopeId = scopeId,
                    LimitUsd = limit,
                    ConsumedUsd = consumed,
                    Enforcement = enforcement
                });
            }
        }
    }

    private ActionsGuardrailSnapshot? UpdateActionsGuardrails(ActionsGuardrailSnapshot? snapshot)
    {
        if (snapshot is null)
        {
            return null;
        }

        return snapshot with
        {
            Budgets = _form.UseActionsBudget
                ? [new ActionsSpendingBudget
                {
                    Id = "actions-budget",
                    LimitUsd = _form.ActionsBudgetLimit,
                    ConsumedUsd = _form.ActionsBudgetConsumed,
                    Enforcement = _form.ActionsBudgetEnforcement
                }]
                : []
        };
    }

    private RuntimeGuardrailSnapshot? UpdateRuntimeGuardrails(RuntimeGuardrailSnapshot? snapshot)
    {
        if (!_form.UseRuntimeGuardrails)
        {
            return null;
        }

        return (snapshot ?? new RuntimeGuardrailSnapshot()) with
        {
            MaximumModelCalls = _form.MaximumModelCalls,
            ModelCallsConsumed = _form.ModelCallsConsumed,
            MaximumSubagentDepth = _form.MaximumSubagentDepth,
            RequestedSubagentDepth = _form.RequestedSubagentDepth,
            MaximumDuration = _form.MaximumDurationMinutes is null
                ? null
                : TimeSpan.FromMinutes((double)_form.MaximumDurationMinutes.Value),
            ElapsedDuration = TimeSpan.FromMinutes((double)_form.ElapsedDurationMinutes),
            RequestedDuration = TimeSpan.FromMinutes((double)_form.RequestedDurationMinutes),
            CliSoftCreditLimit = _form.CliSoftCreditLimit,
            CliCreditsConsumed = _form.CliCreditsConsumed
        };
    }

    private void ApplyAndRun()
    {
        ApplyOverrides();
        if (_error is null)
        {
            RunJsonCore(advanceWorkingState: true);
        }
    }

    private void RunJson() => RunJsonCore(advanceWorkingState: true);

    private void RunJsonCore(bool advanceWorkingState)
    {
        try
        {
            RunScenario(ScenarioJson.Deserialize(_scenarioJson), advanceWorkingState);
        }
        catch (Exception exception) when (exception is JsonException or SimulationException or InvalidOperationException)
        {
            _result = null;
            _error = exception is SimulationException simulation
                ? $"{simulation.Code}: {simulation.Message}"
                : exception.Message;
            _notice = null;
        }
    }

    private void RunScenario(
        SimulationScenario scenario,
        bool advanceWorkingState)
    {
        if (_form.RepeatCount is < 1 or > 1000)
        {
            throw new SimulationException("Repeat task must be between 1 and 1000.", "repeat-count-invalid");
        }

        _runs.Clear();
        var current = scenario;
        for (var iteration = 0; iteration < _form.RepeatCount; iteration++)
        {
            var result = ActiveEngine.Simulate(current);
            _runs.Add(result);
            if (result.Decision != SimulationDecision.Allowed)
            {
                break;
            }

            current = AdvanceScenario(current, result);
        }

        _result = _runs[^1];
        if (advanceWorkingState)
        {
            _scenarioJson = ScenarioJson.Serialize(current);
            LoadForm(current);
            _notice = CompletedRuns == 0
                ? "No balances changed because the first run was not allowed."
                : $"Working balances advanced by {CompletedRuns} successful run(s).";
        }
        _error = null;
    }

    private static SimulationScenario AdvanceScenario(
        SimulationScenario scenario,
        SimulationResult result)
    {
        var economic = scenario.EconomicGuardrails;
        if (economic is not null)
        {
            economic = economic with
            {
                EnterprisePoolConsumedCredits =
                    economic.EnterprisePoolConsumedCredits + result.Allocation.IncludedCredits,
                UserLevelBudgets = economic.UserLevelBudgets
                    .Select(budget => budget.Id == result.EffectiveUlb?.Id
                        ? budget with
                        {
                            ConsumedCredits = budget.ConsumedCredits + result.Allocation.TotalCredits
                        }
                        : budget)
                    .ToArray(),
                IncludedUsageControls = economic.IncludedUsageControls
                    .Select(control => control.CostCenterId == result.Attribution?.CostCenterId
                        ? control with
                        {
                            ConsumedCredits = control.ConsumedCredits + result.Allocation.IncludedCredits
                        }
                        : control)
                    .ToArray(),
                SpendingBudgets = economic.SpendingBudgets
                    .Select(budget => result.Allocation.MeteredBudgetRemainingUsd.ContainsKey(budget.Id)
                        ? budget with
                        {
                            ConsumedUsd = budget.ConsumedUsd + result.Allocation.MeteredUsd
                        }
                        : budget)
                    .ToArray()
            };
        }

        var runtime = scenario.RuntimeGuardrails;
        if (runtime is not null && scenario.CheckScope == SimulationCheckScope.All)
        {
            runtime = runtime with
            {
                ModelCallsConsumed = runtime.ModelCallsConsumed + scenario.Calls.Count,
                ElapsedDuration = runtime.ElapsedDuration + runtime.RequestedDuration,
                CliCreditsConsumed = runtime.CliCreditsConsumed + result.Allocation.TotalCredits
            };
        }

        var actions = scenario.ActionsGuardrails;
        if (actions is not null && result.ActionsUsage is not null)
        {
            actions = actions with
            {
                ConsumedIncludedMinutes =
                    actions.ConsumedIncludedMinutes + result.ActionsUsage.IncludedMinutes,
                Budgets = actions.Budgets
                    .Select(budget => budget with
                    {
                        ConsumedUsd = budget.ConsumedUsd + result.ActionsUsage.AdditionalUsd
                    })
                    .ToArray()
            };
        }

        return scenario with
        {
            EconomicGuardrails = economic,
            RuntimeGuardrails = runtime,
            ActionsGuardrails = actions
        };
    }

    private void ReloadGuidedFields()
    {
        try
        {
            LoadForm(ScenarioJson.Deserialize(_scenarioJson));
            _error = null;
            _notice = "Guided fields refreshed from JSON.";
        }
        catch (JsonException exception)
        {
            _error = exception.Message;
        }
    }

    private void LoadForm(SimulationScenario scenario)
    {
        var call = scenario.Calls.FirstOrDefault();
        var userId = scenario.Attribution?.UserId;
        var costCenterId = scenario.Attribution?.DirectAssignments.FirstOrDefault()?.CostCenterId;
        var universalUlb = scenario.EconomicGuardrails?.UserLevelBudgets
            .FirstOrDefault(x => x.Kind == UserLevelBudgetKind.Universal);
        var costCenterUlb = scenario.EconomicGuardrails?.UserLevelBudgets
            .FirstOrDefault(x =>
                x.Kind == UserLevelBudgetKind.CostCenter &&
                string.Equals(x.TargetId, costCenterId, StringComparison.OrdinalIgnoreCase));
        var individualUlb = scenario.EconomicGuardrails?.UserLevelBudgets
            .FirstOrDefault(x =>
                x.Kind == UserLevelBudgetKind.Individual &&
                string.Equals(x.TargetId, userId, StringComparison.OrdinalIgnoreCase));
        var enterpriseBudget = scenario.EconomicGuardrails?.SpendingBudgets
            .FirstOrDefault(x => x.Scope == SpendingBudgetScope.Enterprise);
        var costCenterBudget = scenario.EconomicGuardrails?.SpendingBudgets
            .FirstOrDefault(x => x.Scope == SpendingBudgetScope.CostCenter);
        var organizationBudget = scenario.EconomicGuardrails?.SpendingBudgets
            .FirstOrDefault(x => x.Scope == SpendingBudgetScope.Organization);
        var includedControl = scenario.EconomicGuardrails?.IncludedUsageControls.FirstOrDefault();
        var actionsBudget = scenario.ActionsGuardrails?.Budgets.FirstOrDefault();
        _form = new GuidedForm
        {
            Task = scenario.Metadata.GetValueOrDefault("task", ""),
            OperationId = scenario.OperationId,
            PlanId = scenario.PlanId,
            CostChecksOnly = scenario.CheckScope == SimulationCheckScope.CostRelatedOnly,
            RepositoryVisibility = scenario.RepositoryVisibility,
            ModelId = call?.ModelId ?? ActiveConfiguration.Models.First().Id,
            ContextTokens = call?.ContextTokens ?? 0,
            FreshInputTokens = call?.FreshInputTokens ?? 0,
            CachedInputTokens = call?.CachedInputTokens ?? 0,
            CacheWriteTokens = call?.CacheWriteTokens ?? 0,
            OutputTokens = call?.OutputTokens ?? 0,
            CostCenterId = costCenterId ?? "",
            OrganizationId = scenario.Attribution?.LicensingOrganizationIds.FirstOrDefault() ?? "",
            PoolConsumed = scenario.EconomicGuardrails?.EnterprisePoolConsumedCredits ?? 0,
            UseUniversalUlb = universalUlb is not null,
            UniversalUlbLimit = universalUlb?.LimitCredits ?? 0,
            UniversalUlbConsumed = universalUlb?.ConsumedCredits ?? 0,
            UseCostCenterUlb = costCenterUlb is not null,
            CostCenterUlbLimit = costCenterUlb?.LimitCredits ?? 0,
            CostCenterUlbConsumed = costCenterUlb?.ConsumedCredits ?? 0,
            UseIndividualUlb = individualUlb is not null,
            UlbLimit = individualUlb?.LimitCredits ?? 0,
            UlbConsumed = individualUlb?.ConsumedCredits ?? 0,
            UseIncludedControl = includedControl is not null,
            IncludedControlConsumed = includedControl?.ConsumedCredits ?? 0,
            IncludedOverflow = includedControl?.OverflowBehavior ?? IncludedOverflowBehavior.PaidUsage,
            PaidUsage = scenario.EconomicGuardrails?.PaidUsage.State ?? GuardrailValue.Unknown,
            UseCostCenterBudget = costCenterBudget is not null,
            CostCenterBudgetLimit = costCenterBudget?.LimitUsd ?? 0,
            CostCenterBudgetConsumed = costCenterBudget?.ConsumedUsd ?? 0,
            CostCenterBudgetEnforcement = costCenterBudget?.Enforcement ?? GuardrailEnforcement.HardStop,
            UseOrganizationBudget = organizationBudget is not null,
            OrganizationBudgetLimit = organizationBudget?.LimitUsd ?? 0,
            OrganizationBudgetConsumed = organizationBudget?.ConsumedUsd ?? 0,
            OrganizationBudgetEnforcement = organizationBudget?.Enforcement ?? GuardrailEnforcement.HardStop,
            UseEnterpriseBudget = enterpriseBudget is not null,
            EnterpriseBudgetLimit = enterpriseBudget?.LimitUsd ?? 0,
            EnterpriseBudgetConsumed = enterpriseBudget?.ConsumedUsd ?? 0,
            EnterpriseBudgetEnforcement = enterpriseBudget?.Enforcement ?? GuardrailEnforcement.HardStop,
            ActionsMinutes = scenario.ActionsUsage?.Minutes ?? 0,
            UseActionsBudget = actionsBudget is not null,
            ActionsBudgetLimit = actionsBudget?.LimitUsd ?? 0,
            ActionsBudgetConsumed = actionsBudget?.ConsumedUsd ?? 0,
            ActionsBudgetEnforcement = actionsBudget?.Enforcement ?? GuardrailEnforcement.HardStop,
            UseRuntimeGuardrails = scenario.RuntimeGuardrails is not null,
            MaximumModelCalls = scenario.RuntimeGuardrails?.MaximumModelCalls,
            ModelCallsConsumed = scenario.RuntimeGuardrails?.ModelCallsConsumed ?? 0,
            MaximumSubagentDepth = scenario.RuntimeGuardrails?.MaximumSubagentDepth,
            RequestedSubagentDepth = scenario.RuntimeGuardrails?.RequestedSubagentDepth ?? 0,
            MaximumDurationMinutes = scenario.RuntimeGuardrails?.MaximumDuration is null
                ? null
                : (decimal)scenario.RuntimeGuardrails.MaximumDuration.Value.TotalMinutes,
            ElapsedDurationMinutes = (decimal)(scenario.RuntimeGuardrails?.ElapsedDuration.TotalMinutes ?? 0),
            RequestedDurationMinutes = (decimal)(scenario.RuntimeGuardrails?.RequestedDuration.TotalMinutes ?? 0),
            CliSoftCreditLimit = scenario.RuntimeGuardrails?.CliSoftCreditLimit,
            CliCreditsConsumed = scenario.RuntimeGuardrails?.CliCreditsConsumed ?? 0,
            RepeatCount = ReadRepeatCount(scenario.Metadata)
        };
    }

    private async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, _scenarioJson);
            await JS.InvokeVoidAsync("localStorage.setItem", CatalogStorageKey, _catalogJson);
            var preferences = JsonSerializer.Serialize(new DisplayPreferences(
                _visibilityMode,
                _hiddenCategories.ToArray()));
            await JS.InvokeVoidAsync("localStorage.setItem", PreferenceStorageKey, preferences);
            _notice = "Scenario saved in this browser.";
            _error = null;
        }
        catch (JSException exception)
        {
            _error = $"Browser storage is unavailable: {exception.Message}";
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (string.IsNullOrWhiteSpace(saved))
            {
                _error = "No saved scenario was found in this browser.";
                return;
            }

            var savedCatalog = await JS.InvokeAsync<string?>("localStorage.getItem", CatalogStorageKey);
            if (!string.IsNullOrWhiteSpace(savedCatalog))
            {
                _catalogJson = savedCatalog;
                ApplyCatalog();
            }

            var savedPreferences = await JS.InvokeAsync<string?>("localStorage.getItem", PreferenceStorageKey);
            if (!string.IsNullOrWhiteSpace(savedPreferences))
            {
                var preferences = JsonSerializer.Deserialize<DisplayPreferences>(savedPreferences);
                if (preferences is not null)
                {
                    _visibilityMode = preferences.VisibilityMode;
                    _hiddenCategories.Clear();
                    _hiddenCategories.UnionWith(preferences.HiddenCategories);
                }
            }

            _scenarioJson = saved;
            ReloadGuidedFields();
            RunJsonCore(advanceWorkingState: false);
            _notice = "Saved scenario loaded.";
        }
        catch (JSException exception)
        {
            _error = $"Browser storage is unavailable: {exception.Message}";
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("simulator.downloadText", "copilot-simulation.json", _scenarioJson);
        }
        catch (JSException exception)
        {
            _error = $"The scenario could not be exported: {exception.Message}";
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _scenarioJson = await reader.ReadToEndAsync();
            ReloadGuidedFields();
            RunJsonCore(advanceWorkingState: false);
            _notice = $"Imported {args.File.Name}.";
        }
        catch (Exception exception) when (exception is IOException or JsonException)
        {
            _error = exception.Message;
        }
    }

    private bool ShouldShow(AppliedGuardrail guardrail) =>
        _visibilityMode switch
        {
            "issues" => guardrail.Outcome != GuardrailOutcome.Passed,
            "failures" => guardrail.Outcome is GuardrailOutcome.Blocked or GuardrailOutcome.Indeterminate,
            "custom" => !_hiddenCategories.Contains(guardrail.Category),
            _ => true
        };

    private void SetCategory(string category, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _hiddenCategories.Remove(category);
        }
        else
        {
            _hiddenCategories.Add(category);
        }
    }

    private void ApplyCatalog()
    {
        try
        {
            _activeConfiguration = ScenarioJson.DeserializeConfiguration(_catalogJson);
            _activeEngine = new CopilotUsageSimulationEngine(_activeConfiguration);
            _error = null;
            _notice = $"Catalog '{_activeConfiguration.Version}' applied.";
        }
        catch (Exception exception) when (exception is JsonException or ConfigurationException)
        {
            _error = exception.Message;
            _notice = null;
        }
    }

    private void ResetCatalog()
    {
        _activeConfiguration = DefaultConfiguration;
        _activeEngine = DefaultEngine;
        _catalogJson = ScenarioJson.SerializeConfiguration(DefaultConfiguration);
        _error = null;
    }

    private static string StatusClass(string value) => value.ToLowerInvariant().Replace("stopped", "-stopped");
    private static string FormatDecision(SimulationDecision decision) => decision switch
    {
        SimulationDecision.PartiallySimulated => "Partially simulated",
        SimulationDecision.SoftStopped => "Soft stopped",
        _ => decision.ToString()
    };
    private static string Format(decimal value) => value.ToString("0.####");
    private static string FormatNullable(decimal? value) => value?.ToString("0.####") ?? "—";
    private string BlockingSourceLabel(AppliedGuardrail? guardrail) => guardrail?.Category switch
    {
        "runtime" => guardrail.Id switch
        {
            "runtime.duration" => "Agent runtime duration limit",
            "runtime.model-calls" => "Agent model-call limit",
            "runtime.subagent-depth" => "Agent subagent-depth limit",
            "runtime.cli-soft-credits" => "CLI session credit limit",
            _ => "Agent runtime limit"
        },
        "user-level-budget" => _result?.EffectiveUlb?.Kind switch
        {
            UserLevelBudgetKind.Individual => "Individual ULB",
            UserLevelBudgetKind.CostCenter => "Cost-center ULB",
            UserLevelBudgetKind.Universal => "Universal ULB",
            _ => "User-level budget (ULB)"
        },
        "included-usage-control" => "Cost-center included-usage control",
        "included-pool" => "Enterprise included-credit pool",
        "metered-spending-budget" => "Metered spending budget",
        "paid-usage-authorization" => "Paid-usage authorization",
        "actions-budget" => "GitHub Actions spending budget",
        "actions-access" => "GitHub Actions access policy",
        _ => FriendlyGuardrailId(_result?.FirstFailingGate)
    };
    private static string BlockingScopeExplanation(AppliedGuardrail? guardrail) => guardrail?.Category switch
    {
        "runtime" => "This is an agent runtime guardrail, not a cost-center, ULB, or spending-budget block. Later economic checks were not reached.",
        "user-level-budget" => "The effective ULB for this user stopped the run. Cost-center controls and spending budgets are separate, later checks.",
        "included-usage-control" => "The attributed cost center stopped included-credit overflow. This is not an individual ULB.",
        "included-pool" => "The enterprise shared included-credit pool could not cover the allocation.",
        "metered-spending-budget" => "A hard-stop spending budget could not cover the metered charge. The check ID identifies the configured budget.",
        "paid-usage-authorization" => "Included credits were insufficient and paid usage was unavailable or not authorized.",
        "actions-budget" => "The GitHub Actions budget stopped the runner charge; Copilot AI-credit budgets are separate.",
        "actions-access" => "A GitHub Actions access or approval policy stopped the run before economic guardrails.",
        _ => "The first failing check below is the guardrail that stopped the simulation."
    };
    private static string BlockingUnit(AppliedGuardrail guardrail) => guardrail.Id switch
    {
        "runtime.duration" => "min",
        "runtime.model-calls" => "calls",
        "runtime.subagent-depth" => "levels",
        _ when guardrail.Category is "metered-spending-budget" or "actions-budget" => "USD",
        _ when guardrail.Category is "user-level-budget" or "included-usage-control" or "included-pool" => "credits",
        _ => ""
    };
    private static string BlockingProjectionLabel(AppliedGuardrail guardrail) =>
        guardrail.RemainingAfter < 0 ? "Shortfall" : "Projected remaining";
    private static string FormatBlockingProjection(AppliedGuardrail guardrail) =>
        guardrail.RemainingAfter is null ? "—" : Format(Math.Abs(guardrail.RemainingAfter.Value));
    private bool IsBlockingCategory(string category) =>
        string.Equals(BlockingGuardrail?.Category, category, StringComparison.OrdinalIgnoreCase);
    private bool IsBlockingGate(string gateId) =>
        string.Equals(_result?.FirstFailingGate, gateId, StringComparison.OrdinalIgnoreCase);
    private string UlbImpactClass(UserLevelBudgetKind kind) =>
        IsBlockingCategory("user-level-budget") && _result?.EffectiveUlb?.Kind == kind
            ? "impacted-setting"
            : "";
    private string ImpactClass(string category) =>
        _result?.FirstFailingGate is null
            ? ""
            : category == "scenario-json"
                ? BlockingSettingsAnchor(BlockingGuardrail) == "scenario-json" ? "impacted-setting" : ""
                : IsBlockingCategory(category) ? "impacted-setting" : "";
    private bool IsBlockingAdvancedSetting =>
        _result?.FirstFailingGate is not null &&
        BlockingSettingsAnchor(BlockingGuardrail) == "scenario-json";
    private string BlockingSettingsAnchor(AppliedGuardrail? guardrail) => guardrail?.Category switch
    {
        "runtime" => "runtime-settings",
        "user-level-budget" => _result?.EffectiveUlb?.Kind switch
        {
            UserLevelBudgetKind.Individual => "individual-ulb-settings",
            UserLevelBudgetKind.CostCenter => "cost-center-ulb-settings",
            UserLevelBudgetKind.Universal => "universal-ulb-settings",
            _ => "scenario-json"
        },
        "included-usage-control" => "included-control-settings",
        "included-pool" => "pool-settings",
        "paid-usage-authorization" => "paid-usage-settings",
        "metered-spending-budget" when IsBlockingGate("budget-cost-center") =>
            "cost-center-budget-settings",
        "metered-spending-budget" when IsBlockingGate("budget-organization") =>
            "organization-budget-settings",
        "metered-spending-budget" when IsBlockingGate("budget-enterprise") =>
            "enterprise-budget-settings",
        "actions-budget" => "actions-budget-settings",
        _ => "scenario-json"
    };
    private static string FriendlyGuardrailId(string? id) =>
        string.IsNullOrWhiteSpace(id)
            ? "Policy guardrail"
            : id.Replace(".", " ").Replace("-", " ");
    private static string Friendly(string value) =>
        string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
    private static int ReadRepeatCount(IReadOnlyDictionary<string, string> metadata) =>
        metadata.TryGetValue("repeatCount", out var value) &&
        int.TryParse(value, out var count) &&
        count is >= 1 and <= 1000
            ? count
            : 1;

